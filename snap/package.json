    "@noble/hashes": "1.8.0",
    "@swc/core": "^1.11.31",
    "@swc/jest": "^0.2.38",
    "jest": "^29.7.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@metamask/snaps-simulation": "4.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
