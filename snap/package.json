{
  "name": "@hyperodds/snap",
  "version": "0.1.0",
  "description": "Explains Hyperliquid signature requests in plain words before you sign them in MetaMask.",
  "keywords": [
    "metamask",
    "snap",
    "hyperliquid",
    "signature-insight",
    "eip-712"
  ],
  "homepage": "https://usehyperodds.com/metamask",
  "repository": {
    "type": "git",
    "url": "https://github.com/usehyperodds/hyperodds-plugins.git",
    "directory": "snap"
  },
  "bugs": {
    "url": "https://github.com/usehyperodds/hyperodds-plugins/issues"
  },
  "license": "MIT",
  "author": "Hyperodds <dev@usehyperodds.com> (https://usehyperodds.com)",
  "sideEffects": false,
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "mm-snap build",
    "prepack": "mm-snap build",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
