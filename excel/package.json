{
  "name": "hyperodds-excel",
  "version": "1.0.0",
  "private": true,
  "description": "Live HIP-4 odds as Excel functions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "validate": "office-addin-manifest validate dist/manifest.xml",
    "live": "node --experimental-eventsource --disable-warning=UNDICI-ES scripts/live.mjs",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "custom-functions-metadata": "3.0.1",
    "esbuild": "0.28.2",
    "office-addin-manifest": "3.0.1",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3"
  }
}
